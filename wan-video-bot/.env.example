# Copy to .env and fill in:  cp .env.example .env && nano .env

# From @BotFather in Telegram
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Your Telegram user ID (send /whoami to the bot). Comma-separate to allow more people.
ALLOWED_USER_IDS=

# Where videos are rendered:
#   fal      = phone only, rendered on fal.ai (pay per video)   <- default
#   comfyui  = your own NVIDIA GPU machine running ComfyUI
BACKEND=fal

# Spend guard: max videos per day (0 = unlimited)
MAX_VIDEOS_PER_DAY=10

# Give up on a render after this many seconds
RENDER_TIMEOUT_S=1800

# ---------- fal.ai (BACKEND=fal) ----------
# API key from https://fal.ai/dashboard/keys
FAL_KEY=
# Wan 2.2 image-to-video model on fal.ai. 5B = cheaper/faster, A14B = higher quality.
FAL_MODEL=fal-ai/wan/v2.2-5b/image-to-video
# FAL_MODEL=fal-ai/wan/v2.2-a14b/image-to-video
# Optional: e.g. 480p (cheaper, for testing) or 720p
# FAL_RESOLUTION=480p
# Optional: any other model parameters as JSON, see the model's API page on fal.ai
# FAL_EXTRA_ARGS={"num_frames": 81}

# ---------- ComfyUI (BACKEND=comfyui) ----------
# Your GPU machine's Tailscale IP or MagicDNS name, port 8188
COMFY_URL=http://100.x.y.z:8188
WORKFLOW=workflows/wan22_5b_i2v_api.json
# 5B model: width/height multiples of 32; frames = 4n+1 (121 = 5s @ 24fps, 73 = 3s)
# VIDEO_WIDTH=832
# VIDEO_HEIGHT=480
# VIDEO_FRAMES=73
# Only if auto-detection fails: node ID of the positive prompt in your workflow
# PROMPT_NODE_ID=
